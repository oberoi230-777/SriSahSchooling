{
  "name": "sri-sah-schooling",
  "version": "1.0.0",
  "private": true,
  "description": "Secure, curriculum-aware learning platform for students, families and tutors.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "start": "node server/index.js",
    "preview": "vite preview --config vite.config.js --host 0.0.0.0 --port 4173",
    "migrate": "node db/migrate.js",
    "bootstrap": "node scripts/bootstrap.js",
    "test": "node --test tests/security.test.js tests/api.e2e.test.js tests/postgres.integration.test.js",
    "test:unit": "node --test tests/security.test.js",
    "test:e2e": "node --test tests/api.e2e.test.js",
    "test:integration": "node --test tests/postgres.integration.test.js",
    "test:render": "node --test tests/render.smoke.mjs",
    "verify": "npm run test:unit && npm run test:render && npm run build",
    "icons": "python3 tools/make-icons.py",
    "seed:demo": "node tools/seed-demo.mjs",
    "android:configure": "node scripts/android-configure.mjs",
    "android:build:web": "node scripts/build-android-web.mjs",
    "android:sync": "npm run android:build:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "express": "^4.21.2",
    "lucide-react": "^0.545.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "9.2.5",
    "jsdom": "^27.0.0",
    "vite": "^6.3.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
