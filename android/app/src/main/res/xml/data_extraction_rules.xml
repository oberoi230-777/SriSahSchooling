<?xml version="1.0" encoding="utf-8"?>
<!--
  SriSah stores no school data on the device: the WebView holds only an HTTP-only session
  cookie and a cached application shell. Device-to-device transfer and cloud backup are
  therefore both disabled so a signed-in session or cached record cannot leak onto a
  personal Google account.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
