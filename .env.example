# ---------------------------------------------------------------------------------------
# SriSah Schooling — environment template
#
# Copy to `.env` (git-ignored) and replace every CHANGE_ME value. Use long, unique,
# URL-safe secrets. Never commit a real .env, keystore or student data.
# ---------------------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Canonical origin for the public site, portal and account email links. Must be a bare
# origin: no trailing slash, no path, no credentials. HTTPS is mandatory in production.
PUBLIC_ORIGIN=http://localhost:5173

# Organization slug used by the public site for article publishing and enquiry routing.
PUBLIC_SITE_ORG_SLUG=srisah

# Comma-separated list of browser origins allowed to call the API. Must include
# PUBLIC_ORIGIN. Add extra school hosts here if you serve the portal from more than one
# domain (for example https://school.example.in,https://portal.example.in).
ALLOWED_ORIGINS=http://localhost:5173

# Set true only when the app sits behind exactly one trusted TLS reverse proxy hop
# (nginx/Caddy/Cloudflare). Leave false when clients reach Node directly.
TRUST_PROXY=false

# Secure cookies are forced automatically in production. Keep true for HTTPS deployments.
COOKIE_SECURE=false

# --- Database --------------------------------------------------------------------------
# Schema owner: used only by `npm run migrate` and `npm run bootstrap`.
MIGRATION_DATABASE_URL=postgres://srisah_migrator:CHANGE_ME@127.0.0.1:5432/srisah_schooling
# Application role: must be NOSUPERUSER, NOBYPASSRLS and must NOT own the tables.
DATABASE_URL=postgres://srisah_app:CHANGE_ME@127.0.0.1:5432/srisah_schooling
DATABASE_SSL=false
MIGRATION_DATABASE_SSL=false
DB_POOL_SIZE=10

# --- Email (Resend) --------------------------------------------------------------------
# Required in production for verification, password reset and invitations.
RESEND_API_KEY=
EMAIL_FROM=SriSah Schooling <no-reply@example.com>
# Development only: print one-time account links to the API console instead of sending.
DEV_EMAIL_LOG=true

# --- First organization bootstrap (`npm run bootstrap`, run once) ----------------------
BOOTSTRAP_ORG_NAME=SriSah Schooling
BOOTSTRAP_ORG_SLUG=srisah
BOOTSTRAP_JOIN_CODE=CHANGE_ME_PRIVATE_FAMILY_ENROLLMENT_CODE
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=School Administrator
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_12_CHARS_WITH_Upper_and_1_number

# --- Docker Compose only ---------------------------------------------------------------
POSTGRES_DB=srisah_schooling
POSTGRES_USER=srisah_migrator
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME_DIFFERENT_FROM_POSTGRES_PASSWORD
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3001

# --- Android build (optional) ----------------------------------------------------------
# HTTPS origin the native app should load. Leave empty to package the bundled UI only.
SRISAH_APP_URL=
SRISAH_VERSION_CODE=1
SRISAH_VERSION_NAME=1.0.0
